# Généré par config/rangs/generer.py depuis config/rangs/rangs.toml : ne pas
# modifier à la main.

# Les rangs FTB Ranks acquis (permissions des commandes). Ré-ajouter un rang
# déjà présent ne change rien : appelée à l'achat et à chaque connexion.
# Le sélecteur porte type=minecraft:player : l'argument joueur de FTB Ranks
# refuse un @s nu au chargement (« Only players may be affected »).

execute if score @s bmc4_rangs matches 1.. run ftbranks add @s[type=minecraft:player] rang_1
execute if score @s bmc4_rangs matches 2.. run ftbranks add @s[type=minecraft:player] rang_2
