			}]
			title: "Les bêtes de l'Everdawn"
			x: 2.0d
			y: 3.5d
		}
		{
			dependencies: ["526DABEE6B35A5BB"]
			description: ["Marcher dans un &5champignon de l'exil&r et en subir les conséquences : un progrès que le mod accorde à qui ne lit pas les panneaux."]
			id: "54E7F5ECF4473509"
