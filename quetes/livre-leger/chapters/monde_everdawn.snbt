		}
		{
			dependencies: ["2E032B78873BFE1F"]
			description: ["La charoite se fond depuis son minerai brut ; avec la pyrope, l'aquite et le diopside, c'est l'une des quatre gemmes communes aux deux mondes."]
			id: "3F315EFE607FD11D"
