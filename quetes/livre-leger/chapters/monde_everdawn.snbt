			title: "&6Entrer dans l'Everdawn"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["526DABEE6B35A5BB"]
			description: ["Lunaire, crépuscubois, érable, comète : des bûches à frapper (progrès du mod). L'érable des forêts de coucher de soleil, le comète des vergers."]
			id: "2E032B78873BFE1F"
