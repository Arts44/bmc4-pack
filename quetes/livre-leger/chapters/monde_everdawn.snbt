			y: 5.0d
		}
		{
			dependencies: ["526DABEE6B35A5BB"]
			description: ["La tour d'illageois de l'Everdawn : une clé par étage, quatre clés sur la keystone du dernier, et l'&cAlchimiste&r derrière. Les objets d'un mort restent à la keystone."]
			id: "64F40D1C37FC27B9"
			rewards: [{
				id: "3896742320954803"
				type: "xp_levels"
				xp_levels: 5
			}]
