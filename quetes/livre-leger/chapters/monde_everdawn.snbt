			}]
			title: "Du bois de l'Everdawn"
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["2E032B78873BFE1F"]
			description: ["Le métal propre à l'Everdawn, fondu depuis son minerai brut. Il fait un équipement, et surtout la forge."]
			id: "4E870680E8DE904A"
			rewards: [{
