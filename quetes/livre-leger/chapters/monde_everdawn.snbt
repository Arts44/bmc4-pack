		}
		{
			dependencies: ["526DABEE6B35A5BB"]
			description: ["Araignées venimeuses, nyctoflies, essaims infestés, crogres : le progrès du mod demande d'avoir tué chaque insecte et arachnide hostile de l'Everdawn. Un bouclier est l'arme de ce monde."]
			id: "656B4548FF4193F9"
			optional: true
