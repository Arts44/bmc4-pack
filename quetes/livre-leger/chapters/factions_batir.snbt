		}
		{
			dependencies: ["705A31B9527AC6AC"]
			description: ["Dans ton salon stratégie, &b!help faction&r liste tout ce que le bot sait faire pour ton équipe. Les deux outils du quotidien sont les tâches et les lieux, juste après."]
			id: "182D32FE7AA82209"
