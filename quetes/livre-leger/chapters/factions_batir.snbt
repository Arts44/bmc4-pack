	quest_links: [ ]
	quests: [
		{
			description: [
				"Une faction, c'est une &léquipe FTB&r : un territoire claim en commun, des salons privés sur le Discord, un diplomate qui parle en son nom, un trophée à défendre. On est dans une faction à la fois, ou &7indépendant&r."
				""
				"Ce chapitre ne demande rien en jeu : il te fait faire le tour des outils, et tu coches quand c'est fait. Les récompenses sont symboliques, c'est voulu."
			]
			icon: "minecraft:white_banner"
			id: "22C871CAB6EBF04E"
			rewards: [{
				id: "59BA2BF444F0822A"
				type: "xp_levels"
				xp_levels: 2
			}]
			size: 1.5d
			subtitle: "Tout se passe dans #diplomatie et dans le salon de ta faction."
			tasks: [{
				id: "5342AF50771FEA39"
				title: "Lu"
				type: "checkmark"
			}]
			title: "&cUne faction, c'est quoi"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["22C871CAB6EBF04E"]
			description: [
				"Pour rejoindre Apex ou Farmer's, demande à l'un de leurs membres : c'est l'équipe FTB qui t'invite (menu FTB Teams en haut à gauche de l'inventaire). Pour en fonder une, la demande se fait dans &9#diplomatie&r : le staff crée l'équipe, les salons et les rôles."
				""
				"Une faction à la fois. En changer, c'est repartir sans ses claims."
			]
			id: "414C16A8615130D2"
			rewards: [{
				id: "6F23B57CBB768EE4"
				type: "xp_levels"
				xp_levels: 3
			}]
			tasks: [{
				id: "76C5CCEE37D63113"
				title: "Je suis dans une faction"
				type: "checkmark"
			}]
			title: "Rejoindre ou fonder"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["414C16A8615130D2"]
			description: [
				"Touche &bM&r, puis le bouton de claim. Une faction dispose de &l40 chunks&r, quel que soit son nombre de membres. Le règlement dit : claim ce qu'on occupe réellement, une seule base par faction, pas de réserve foncière, pas d'encerclement."
				""
				"Dans un claim, les autres ne cassent rien, ne posent rien, et les explosions sont bloquées. Le combat, lui, reste possible."
			]
			id: "0FD94DF572D7D7F9"
			rewards: [{
				id: "5E380A367FB82258"
				type: "xp_levels"
				xp_levels: 3
			}]
			tasks: [{
				id: "45634AD995499BAB"
				title: "Base claim"
				type: "checkmark"
			}]
			title: "Poser la base"
			x: 4.0d
			y: -1.5d
		}
		{
			dependencies: ["0FD94DF572D7D7F9"]
			description: [
				"Les 40 chunks sont un plafond, pas un acquis. Un raid gagné donne &ldeux chunks&r à choisir sur le territoire adverse, et relève le plafond pendant quatorze jours. Un raid perdu en coûte deux, jamais en dessous de cinq."
				""
				"Une faction qui ne se connecte plus pendant un mois voit ses claims libérés, après annonce."
			]
			id: "264AC0CAE5615EA7"
			rewards: [{
				id: "1602D213658DDBB7"
				type: "xp_levels"
				xp_levels: 3
			}]
			tasks: [{
				id: "777591CEF9581609"
				title: "Compris"
				type: "checkmark"
			}]
			title: "Étendre le territoire"
			x: 6.0d
			y: -1.5d
		}
		{
			dependencies: ["0FD94DF572D7D7F9"]
			description: [
				"Une waystone activée reste ouverte &là vie&r à quiconque l'a visitée une fois, ennemi compris, et une téléportation arrive quel que soit le claim. Une waystone à l'intérieur de la base est une porte sans serrure."
				""
				"Les factions la posent hors des murs, ou dans une pièce qu'on peut fermer."
			]
			id: "2EA8F1359FAEB4AF"
			rewards: [{
				id: "507C7D5C5AC34BB9"
				type: "xp_levels"
				xp_levels: 3
