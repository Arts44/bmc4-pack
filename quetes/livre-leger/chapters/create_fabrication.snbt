		}
		{
			dependencies: ["6D5CCFAB7E6EF69C"]
			description: ["Quatre plaques de fer autour d'un bloc de netherrack. Vide, il ne chauffe rien : il faut lui donner un &cBlaze&r. Clic droit sur un Blaze vivant avec le brûleur vide, dans une forteresse du Nether, et le Blaze y reste."]
			icon: "create:empty_blaze_burner"
