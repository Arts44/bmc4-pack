			y: -1.5d
		}
		{
			dependencies: ["48AAB8914728A8BD"]
			description: ["Le &lrenforceur universel&r convertit les blocs vanilla en blocs renforcés : clic droit, le bloc dans la case du haut, ou bien casser un bloc en le tenant. Un &cbloc renforcé&r appartient à qui l'a posé. Un donjon de trophée en pierre renforcée n'a qu'une entrée : celle que tu as laissée, puisque le règlement exige un chemin atteignable sans rien casser."]
			icon: "securitycraft:universal_block_reinforcer_lvl1"
			id: "03B1014F45B0E7AF"
			rewards: [{
				id: "799EC62FBD441887"
