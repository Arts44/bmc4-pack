		}
		{
			dependencies: ["52AE6B5D33770767"]
			description: ["Ardoise polie et obsidienne pleurante : la &5Forge à parchemins&r. Elle fabrique un parchemin avec du papier, une &dencre&r et un &dfoyer&r : l'encre fixe la rareté (donc le niveau), le foyer fixe l'école. C'est le moment où l'on cesse de dépendre du hasard des coffres."]
			icon: "irons_spellbooks:scroll_forge"
