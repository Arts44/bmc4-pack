		}
		{
			dependencies: ["1D99B9C7EA3B1CF1"]
			description: ["Chaînes, cuir, papier : le &7Tome ferré&r, deuxième palier de grimoire, encore sans matière magique. Plus d'emplacements que le journal."]
			icon: "irons_spellbooks:iron_spell_book"
