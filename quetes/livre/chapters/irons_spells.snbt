			title: "&5Devenir mage"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["31E061BF96F2149B"]
			description: ["Les &dparchemins&r se trouvent dans les coffres, sur les mages tués, chez le marchand ambulant. Chacun porte un sort et un niveau. On peut le &lconsommer&r pour lancer le sort une fois, sans mana ni recharge — mais mieux vaut le garder pour l'inscrire dans un grimoire, où il servira sans fin."]
			icon: "irons_spellbooks:scroll"
			id: "5424CD0F4F017837"
			rewards: [{
				id: "3B436ABA6E4141C7"
				type: "xp_levels"
				xp_levels: 3
			}]
			tasks: [{
