				id: "6C1608C895E6D364"
				item: "irons_spellbooks:copper_spell_book"
				type: "item"
			}]
			title: "Un Journal fragile"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["1D99B9C7EA3B1CF1"]
			description: ["Un livre, trois dalles de bois, deux barrières : la &5Table d'inscription&r. On y pose un grimoire et un parchemin, et le sort passe dans le livre. Le parchemin se récupère en retirant le sort. C'est le geste de base de toute la magie du mod."]
			icon: "irons_spellbooks:inscription_table"
			id: "52AE6B5D33770767"
