	quest_links: [ ]
	quests: [
		{
			description: [
				"Trois mods de stockage, trois philosophies. &6Storage Drawers&r : des tiroirs qui montrent ce qu'ils contiennent, parfaits pour les ressources en masse. &aSimple Storage Network&r : un maître, des câbles, une table de requête, et tous les coffres existants deviennent un seul inventaire. &bRefined Storage&r : des disques, une grille, de la fabrication automatique, et de l'énergie."
				""
				"&lN'en choisis qu'un par base&r : ils ne se parlent pas bien entre eux, et une base qui mélange les trois ne retrouve plus rien."
			]
			icon: "minecraft:chest"
			id: "0DC26A01D5547512"
			rewards: [{
				count: 4
				id: "14628F1700AF81C5"
				item: "minecraft:chest"
				type: "item"
			}]
			size: 1.5d
			subtitle: "Choisis-en une par base."
			tasks: [{
				id: "0847C3DA0DE2EE7A"
				title: "Lu"
				type: "checkmark"
			}]
			title: "&6Trois façons de ranger"
			x: 0.0d
			y: 0.0d
		}
		{
			description: ["Un &6tiroir&r à une case stocke un seul type d'objet, en grande quantité, et l'affiche sur sa face. Clic droit pour déposer, clic gauche pour prendre. Il existe en 1, 2 ou 4 cases, et dans chaque bois."]
			icon: "storagedrawers:oak_full_drawers_1"
			id: "17FD9B5F111987DE"
			rewards: [{
				id: "4C0A0801B08B3516"
