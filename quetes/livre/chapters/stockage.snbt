			}]
			title: "Un tiroir de compactage"
			x: 4.0d
			y: -3.75d
		}
		{
			dependencies: ["17FD9B5F111987DE"]
			description: ["Le &6contrôleur&r voit tous les tiroirs qui lui sont reliés par contact. Clic droit dessus avec un objet, et il va dans le bon tiroir ; clic avec les mains vides, et il range tout l'inventaire d'un coup. C'est aussi par lui qu'un tuyau ou un réseau accède à la banque de tiroirs."]
			icon: "storagedrawers:controller"
			id: "759E41067194CD2B"
			rewards: [{
				id: "507F6FA0E7B78A77"
				type: "xp_levels"
