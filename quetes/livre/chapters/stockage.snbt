			}]
			title: "Un premier tiroir"
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["17FD9B5F111987DE"]
			description: ["Le &6tiroir de compactage&r range un même matériau sous ses trois formes à la fois — pépite, lingot, bloc — et convertit tout seul. Du fer entre, du fer sort dans la forme demandée."]
			icon: "storagedrawers:compacting_drawers_3"
			id: "6054CFC02D62E12A"
			rewards: [{
