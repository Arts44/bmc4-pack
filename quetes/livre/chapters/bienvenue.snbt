	quest_links: [ ]
	quests: [
		{
			description: [
				"Tu es au &6Marché Flottant&r, le centre neutre du serveur. BMC4 est un serveur en &cfactions&r : deux camps, Apex et Farmer's, des indépendants, des raids déclarés à l'avance et un trophée à défendre."
				""
				"Ce livre te guide : d'abord les premiers pas ici, puis le monde, les mods, la vie de faction. Tout ce qui ne se passe pas en jeu vit sur le &9Discord&r du serveur."
				""
				"Chaque quête se valide dans l'onglet &9Tâches&r, puis on réclame la &6Récompense&r."
			]
			icon: "ftbquests:book"
			id: "5F06BDBA9B3BC06D"
			rewards: [{
				id: "6C6F5385EF6C561F"
				type: "xp_levels"
				xp_levels: 2
			}]
			size: 1.5d
			subtitle: "Clique sur la quête, lis, coche."
			tasks: [{
				id: "7806758E3C7A6B72"
				title: "Lu !"
				type: "checkmark"
			}]
			title: "&eBienvenue sur BMC4"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["5F06BDBA9B3BC06D"]
			description: [
				"Regarde la &bwaystone&r du Marché pour l'activer. Une waystone activée reste accessible &là vie&r : d'où que tu sois, tu pourras revenir ici."
				""
				"Le parchemin de retour offert te ramène à la dernière waystone activée, une fois. Garde-le pour une mauvaise surprise loin de chez toi."
			]
			id: "29D4C91B218B2DDA"
			rewards: [{
				id: "4F0D276004AD2BBF"
				item: "waystones:return_scroll"
				type: "item"
			}]
			subtitle: "Elle est au centre du Marché Flottant."
			tasks: [{
				id: "1DC4C05E41E4F5D2"
				observe_type: 0
				timer: 0L
				to_observe: "waystones:waystone"
				type: "observation"
			}]
			title: "Activer la waystone du Marché"
			x: 2.0d
			y: -3.0d
		}
		{
			dependencies: ["5F06BDBA9B3BC06D"]
			description: [
				"Le règlement complet est dans &9#règles&r sur le Discord. L'essentiel : pas de griefing hors raid déclaré, pas de triche, et deux &azones neutres&r où l'on ne se bat pas, le Marché Flottant et ses 50 blocs autour."
				""
				"La trêve du Marché ne tient que sur la règle : aucune protection technique ne t'empêchera de frapper, c'est le staff qui sanctionne."
			]
			id: "2A91210CEB418B24"
			rewards: [{
				id: "18FBEF7BCA9C33BC"
				type: "xp_levels"
				xp_levels: 2
			}]
			tasks: [{
				id: "04213F16F8FC3FFE"
				title: "Lu et compris"
				type: "checkmark"
			}]
			title: "Lire le règlement"
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["5F06BDBA9B3BC06D"]
			description: [
				"Tape &b/discord link&r en jeu : tu reçois un code à envoyer au bot sur le Discord. Une fois lié, ton pseudo apparaît dans &9#chat-ingame&r, tes faits d'armes sont publiés à ton nom et les commandes de faction te reconnaissent."
				""
				"Sans ce lien, le bot ne sait pas qui tu es."
			]
			icon: "minecraft:writable_book"
			id: "35B4029C6D31F992"
			rewards: [{
				id: "0811AD6A36BACB4B"
				type: "xp_levels"
				xp_levels: 3
			}]
			tasks: [{
				id: "2F4245BB23D94719"
				title: "Compte lié"
				type: "checkmark"
			}]
			title: "Lier son compte Discord"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["5F06BDBA9B3BC06D"]
			description: [
				"Le serveur a un vocal de proximité : on s'entend jusqu'à &b48 blocs&r, 24 en chuchotant. La touche &bV&r ouvre son menu : choix du micro, de la sortie son, et de la touche pour parler."
				""
				"Par défaut on parle en maintenant une touche. Si l'icône en bas à gauche montre une prise barrée, le vocal n'est pas connecté : dis-le dans &9#général&r."
			]
			icon: "minecraft:note_block"
			id: "4E5D503C021D1B3B"
			rewards: [{
				id: "42655CDB0B4EE5E0"
				type: "xp_levels"
				xp_levels: 3
			}]
			tasks: [{
				id: "4422EE67E379EFBA"
				title: "Micro réglé"
				type: "checkmark"
			}]
			title: "Régler le vocal de proximité"
			x: 2.0d
			y: 1.5d
		}
		{
			dependencies: ["5F06BDBA9B3BC06D"]
			description: [
				"Tu arrives avec un &asac élimé&r (Inmis). Il s'ouvre d'un clic droit et se porte dans la main ou dans l'inventaire."
				""
				"Les sacs ont des paliers : élimé, plaqué, doré, orné de gemmes, ardent, flétri, puis sans fin. Chaque palier ajoute des cases. Le suivant, le &asac plaqué&r, est une quête plus loin."
			]
			icon: "inmis:frayed_backpack"
			id: "5090842DF6D6F968"
			rewards: [{
				id: "7B48EE0CFDB3EC53"
