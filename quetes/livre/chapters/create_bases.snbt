					type: "item"
				}
				{
					count: 32
					id: "61F7C23CA0F665FB"
					item: "minecraft:iron_nugget"
					type: "item"
				}
			]
			size: 1.5d
			subtitle: "Guide complet dans #create sur le Discord."
			tasks: [{
				id: "178FFA20A8282CB1"
				title: "Lu"
				type: "checkmark"
			}]
			title: "&bCreate : la force de rotation"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["77577F8D93529C42"]
			description: ["Le &7zinc&r est le minerai propre à Create. Il se trouve dans la pierre comme le fer, souvent en veines près de la surface. Avec le cuivre, il donne le laiton ; seul, il entre dans l'alliage d'andésite."]
			icon: "create:raw_zinc"
			id: "69AB137697EFC3A4"
			rewards: [{
