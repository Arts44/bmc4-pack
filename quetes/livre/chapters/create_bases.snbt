	quest_links: [ ]
	quests: [
		{
			description: [
				"&bCreate&r remplace l'électricité par la &lrotation&r : une roue tourne, un arbre transmet, une machine travaille. Tout se voit, tout s'entend, et tout se construit avec de l'andésite et du cuivre."
				""
				"Deux réflexes à prendre : la touche &bW&r en survolant un bloc Create ouvre &lPonder&r, une animation qui montre comment il s'utilise ; et la &6clé&r (wrench) tourne ou démonte n'importe quel composant."
				""
				"L'andésite et les pépites de fer offertes font seize alliages : de quoi fabriquer les premiers arbres et engrenages."
			]
			icon: "create:cogwheel"
			id: "77577F8D93529C42"
			rewards: [
				{
					count: 32
					id: "698E3F45A802696F"
