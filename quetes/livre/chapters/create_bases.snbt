			}]
			title: "Fabriquer de l'alliage d'andésite"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["041FB6D57859FC5B"]
			description: ["L'&7arbre&r transmet la rotation en ligne droite, sans changer ni la vitesse ni le sens. Deux alliages l'un sur l'autre en donnent huit. C'est le bloc le plus posé de tout Create."]
			icon: "create:shaft"
			id: "677600E1EAED774E"
			rewards: [{
