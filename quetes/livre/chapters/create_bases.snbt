		}
		{
			dependencies: ["677600E1EAED774E"]
			description: ["La &7manivelle&r se tourne à la main (clic droit maintenu) et donne un peu de rotation, le temps de tester une machine ou de dépanner. Elle creuse la faim : ce n'est pas une source d'énergie, c'est un outil."]
			icon: "create:hand_crank"
			id: "664C4F8E5351980F"
			rewards: [{
