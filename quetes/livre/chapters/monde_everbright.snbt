	quest_links: [ ]
	quests: [
		{
			description: ["&bBlue Skies&r, ce sont deux mondes : l'&bEverbright&r, froid et bleu, l'&6Everdawn&r, chaud et doré. Les deux s'ouvrent dans la maison du &lGatekeeper&r, dans l'Overworld : le portail y est déjà construit, et le Gatekeeper vend le &bJournal bleu&r — le guide du mod — et le &lbriquet zèle&r, huit émeraudes sur ce serveur. Les émeraudes offertes sont pour lui."]
			icon: "blue_skies:blue_journal"
			id: "5DB4410ED946496A"
			rewards: [{
				count: 8
				id: "449E1E6989569AD4"
				item: "minecraft:emerald"
				type: "item"
			}]
			size: 1.5d
			subtitle: "Guide dans #blue-skies sur le Discord."
			tasks: [{
				id: "5693C54F1AAC8A1A"
				structure: "blue_skies:gatekeeper_house_plains"
				type: "structure"
			}]
			title: "&bLa maison du Gatekeeper"
			x: 0.0d
			y: -0.75d
		}
		{
			description: ["Il allume les portails de l'Everbright (pierre taillée turquoise) et de l'Everdawn (pierre taillée lunaire). Les blocs des portails se prennent chez le Gatekeeper si on veut en construire un chez soi."]
			icon: "blue_skies:zeal_lighter"
			id: "08D94C75AAD32FEC"
			rewards: [{
				id: "3A9BB32252C76B90"
				type: "xp_levels"
				xp_levels: 3
			}]
			tasks: [{
				id: "74F788566DA683B6"
				item: "blue_skies:zeal_lighter"
				type: "item"
			}]
			title: "Un briquet zèle"
			x: 0.0d
			y: 0.75d
		}
		{
			dependencies: ["08D94C75AAD32FEC"]
			description: ["Un monde de neige, de lacs et de forêts bleues. Les outils de l'Overworld y mordent mal : le mod le dit lui-même (« ce outil ne marche pas aussi bien ici »), il faut ses bois et ses pierres."]
			id: "1FDA402DA78D4B38"
			rewards: [{
				id: "40FF1253BACD8DC0"
				type: "xp_levels"
				xp_levels: 10
			}]
			size: 1.3d
