			}]
			title: "Entrer dans l'Everbright"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["1FDA402DA78D4B38"]
			description: ["Lumibleu, étoilibois, nifrisque : des bûches à frapper (progrès du mod). Chaque bâton de ces bois a un usage à la boîte à outils."]
			id: "6AAD23682688665F"
