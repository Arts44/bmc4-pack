		}
		{
			dependencies: ["1FDA402DA78D4B38"]
			description: ["L'&bastrolabe&r s'achète au Stargazer d'un village ; lié à un &bémetteur d'étoiles&r, il y ramène d'une distance moyenne, puis se recharge selon la distance. Une waystone de poche pour l'Everbright."]
			icon: "blue_skies:star_emitter"
			id: "73D9EADDCC3215CF"
			optional: true
			rewards: [{
				id: "4B286E35124ABF08"
