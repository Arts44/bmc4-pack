		}
		{
			dependencies: ["1FDA402DA78D4B38"]
			description: ["Une tour d'illageois. Chaque étage cache une &lclé&r ; &lquatre clés aveuglantes&r sur la keystone du dernier étage ouvrent la salle du &5Summonateur&r. Mort dans la salle du boss, les objets restent à la keystone (le mod le dit)."]
			id: "75DD7BFF70E14471"
			rewards: [{
				id: "6173744BCECDC1B8"
				type: "xp_levels"
				xp_levels: 5
			}]
