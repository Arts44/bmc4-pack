				type: "structure"
			}]
			title: "Le donjon aveuglant de l'Everbright"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["1FDA402DA78D4B38"]
			description: ["Il invoque des golems artificiels, à distance puis au corps à corps, et se téléporte — sauf pendant qu'il lance un sort : c'est là qu'on frappe. Il lâche son &5Artéfact éthéré&r et, parfois, la table d'invocation. Sa mort est annoncée dans #faits-d-armes."]
			id: "04A6349A2ECEED79"
			rewards: [{
				id: "3C542B1352598CEC"
				type: "xp_levels"
				xp_levels: 20
			}]
