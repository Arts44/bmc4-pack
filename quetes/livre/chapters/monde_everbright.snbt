			title: "&5Vaincre le Summonateur"
			x: 4.0d
			y: 1.5d
		}
		{
			dependencies: ["04A6349A2ECEED79"]
			description: ["Une pyramide verte dans les &lPins enneigés&r, gardée par des golems de pierre liés par des lianes étoilées. Une clé par étage, une keystone au bout. Le Gatekeeper vend les clés de la nature une fois le donjon aveuglant vaincu (progrès du mod)."]
			id: "498AAAA7903FF443"
			rewards: [{
				id: "38FCBFE799704ED3"
				type: "xp_levels"
				xp_levels: 5
			}]
			tasks: [{
